# ==============================================================
# SpeechBloom AI - Environment Configuration
# ==============================================================

# Django Secret Key
DJANGO_SECRET_KEY=speechbloom-django-production-key-change-me
DJANGO_DEBUG=True

# --------------------------------------------------------------
# Supabase Configuration (https://supabase.com/dashboard/project/_/settings/api)
# --------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Storage & Uploads
UPLOAD_FOLDER=uploads
MODEL_PATH=ml/saved_models
